[Unit]
Description=API Python da plataforma Diesel S-10
Documentation=file:///opt/TCC-modelo1/deploy/README.md
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/TCC-modelo1
ExecStart=/opt/TCC-modelo1/.venv-api/bin/python -m uvicorn api.app.main:create_app --factory --host 127.0.0.1 --port 8080 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1

# Configuracao validada e carregada do .env pelo Python.
Environment=S10_ENVIRONMENT=production

Restart=on-failure
RestartSec=5s

# Escritas de negocio vao ao PostgreSQL/Redis; artefatos locais sao somente leitura.
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
