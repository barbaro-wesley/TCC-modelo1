# Copie para .env.training no host do treinamento. Nao use estes valores em producao.
S10_ENVIRONMENT=development
# Mesmo banco da API; em producao use usuario exclusivo com permissoes model_*.
S10_TRAINING_DATABASE_URL=postgresql://s10:s10-local-only@localhost:5432/s10
# Preencha com o SHA do codigo implantado.
S10_CODE_VERSION=local-development
