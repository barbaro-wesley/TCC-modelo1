# Copie para .env localmente. Nunca commite credenciais reais.
S10_ENVIRONMENT=development
# Neon: use a URL pooled da aplicacao e preserve sslmode=require.
S10_DATABASE_URL=postgresql://s10:s10-local-only@localhost:5432/s10
# Neon: URL direta para migracoes. Opcional em desenvolvimento.
# S10_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
S10_REDIS_URL=redis://localhost:6379/0
# Substitua por: python -c "import secrets; print(secrets.token_urlsafe(48))"
S10_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
S10_ALLOWED_HOSTS=["localhost","127.0.0.1"]
S10_CORS_ORIGINS=[]
S10_PAGE_SIZE=20
S10_MAX_PAGE_SIZE=100
S10_MAX_OFFSET=10000
S10_QUERY_TIMEOUT_MS=5000
S10_GLOBAL_RATE_PER_MINUTE=3000
S10_IP_RATE_PER_MINUTE=120
S10_LOGIN_RATE_PER_MINUTE=10
S10_POOL_SIZE=5
S10_REDIS_PREFIX=s10
S10_MAX_BODY_BYTES=32768
